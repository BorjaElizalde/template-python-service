# From the python-service template: change the template, not this copy.
# The ruff settings every service shares. make gate reads them through the project's
# pyproject.toml, which extends this file: a select or a banned-api there would replace the whole
# list below.
line-length = 100
extend-exclude = ["*.ipynb"]

[lint]
# Preview rules run only when named in `select`; PLC2701 is the one named.
preview = true
explicit-preview-rules = true
select = [
    "F",  # Pyflakes
    "E",  # pycodestyle
    "W",  # pycodestyle
    "I",  # isort
    "N",  # pep8-naming
    "Q",  # flake8-quotes
    "ERA",  # eradicate (commented-out code)
    "BLE001",  # blind except
    "S110",  # try-except-pass
    "S112",  # try-except-continue
    "G004",  # f-string in a log call
    "PLC2701",  # private name imported from another module
    "B",  # flake8-bugbear
    "UP",  # pyupgrade
{%- if 'api' in parts %}
    "FAST",  # FastAPI
{%- endif %}
    "ASYNC",  # flake8-async
    "DTZ",  # flake8-datetimez
    "PGH003",  # blanket type: ignore
    "PGH004",  # blanket noqa
    "ANN",  # flake8-annotations
    "ARG",  # flake8-unused-arguments
    "SIM",  # flake8-simplify
    "RUF",  # Ruff-specific rules
    "TRY",  # tryceratops
    "RET",  # flake8-return
    "PIE",  # flake8-pie
    "C4",  # flake8-comprehensions
    "FBT",  # flake8-boolean-trap
    "TID",  # flake8-tidy-imports
]
# ANN401: basedpyright's reportExplicitAny reports every Any that this rule reports, so with this
# rule off, an Any that must stay takes one skipped check, not two.
# Tried a narrower type, the rule's documented fix, but where one fits, reportExplicitAny asks for
# it too.
# TRY003: most raises have a message of their own, written where the error happens, which is
# where a reader looks for it.
# Tried an exception class that builds its message, the rule's documented fix, but each raise
# would then need a class that only it raises.
ignore = ["ANN401", "TRY003"]
# ERA001: jscpd's markers, `# jscpd:ignore-start` and `# jscpd:ignore-end`, parse as Python, so
# eradicate reads them as commented-out code; it never reads a comment that starts with a task tag
# as code. The other task tags are ruff's defaults.
# Tried words after each marker, which stop it parsing, but a bare marker is the form jscpd
# documents, and words added only to get past ERA001 say nothing.
# Tried `# noqa: ERA001` on each marker, but then every allowed copy carries two skipped checks.
task-tags = ["TODO", "FIXME", "XXX", "jscpd"]

[lint.per-file-ignores]
# ANN: in tests the rule asks mostly for `-> None` on test functions: noise on every test for
# little checking. Its parameter codes ask for the types that basedpyright's
# reportMissingParameterType asks for in tests too.
# Tried annotating the tests, but suppress-none-returning, which drops the `-> None` hits, would
# stop requiring `-> None` in the package too.
# Tried listing only the return-type codes, but the list would be a longer ANN that checks no more.
# Tried ignore-fully-untyped, but it leaves most test hits and exempts untyped package code.
# Tried mypy-init-return, suppress-dummy-args and allow-star-arg-any, but they clear no test hit.
"tests/**" = ["ANN"]

[lint.flake8-tidy-imports.banned-api."typing.cast"]
msg = "cast hides a type error from basedpyright: narrow the type, or validate the data"

[lint.flake8-bandit]
check-typed-exception = true
