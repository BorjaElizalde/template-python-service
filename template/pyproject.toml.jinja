[project]
name = "{{ package_name }}"
version = "0.1.0"
# One minor version: under a floor, uv can take a newer Python that some packages have no wheel for.
requires-python = "==3.14.*"
dependencies = []

[dependency-groups]
dev = [
    "bandit",
    "basedpyright",
    "jscpd",
    "pre-commit",
    "pre-commit-hooks",
    "pytest",
    "pytest-cov",
    "ruff",
]

# A setting here replaces the shared one; ignore and the extend- settings add to it.
[tool.ruff]
extend = "ruff.base.toml"

[tool.basedpyright]
extends = "basedpyright.base.json"

[tool.coverage.run]
relative_files = true
source = ["."]
omit = ["tests/*"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
filterwarnings = ["error"]
